# CryptPad - tester-env deployment image (built from editable source).
#
# Strategy for the mutation workflow:
#   1. deps stage (node:lts-alpine): package.json + package-lock.json first so
#      `npm install --production` is cached across small source mutations.
#   2. components stage: `npm run install:components` copies vendored libs into
#      www/components (also cached unless node_modules change).
#   3. final stage: full source COPY so mutant patches rebuild only the
#      tail layers. `config/config.tester-env.js` is generated at deploy time
#      (not baked) so PORT/RUN_ID stay runtime parameters.
#   4. `npm run build` (slow, several minutes) runs at container START, not at
#      image build, mirroring upstream docker-entrypoint.sh. Image builds stay
#      fast; cold container first-boot pays the build cost once.
FROM node:lts-alpine AS deps
WORKDIR /cryptpad
COPY package.json package-lock.json ./
RUN npm install --production

FROM node:lts-alpine AS components
WORKDIR /cryptpad
COPY --from=deps /cryptpad/node_modules ./node_modules
COPY scripts/copy-components.js ./scripts/copy-components.js
COPY customize.dist ./customize.dist
COPY package.json ./
RUN npm run install:components

FROM node:lts-alpine
RUN addgroup -S cryptpad -g 4001 && adduser -S cryptpad -G cryptpad --uid 4001 -h /cryptpad \
    && apk add --no-cache ca-certificates bash curl
COPY --from=components --chown=cryptpad /cryptpad /cryptpad
WORKDIR /cryptpad
# Full editable source on top of the cached dependency layers.
COPY --chown=cryptpad . /cryptpad
USER cryptpad
RUN mkdir -p blob block customize data datastore \
    && sed -i "s@//httpAddress: 'localhost'@httpAddress: '0.0.0.0'@" config/config.example.js \
    && sed -i "s@installMethod: 'unspecified'@installMethod: 'docker'@" config/config.example.js
VOLUME /cryptpad/blob
VOLUME /cryptpad/block
VOLUME /cryptpad/customize
VOLUME /cryptpad/data
VOLUME /cryptpad/datastore
HEALTHCHECK --interval=1m CMD curl -f http://localhost:${CPAD_MAIN_PORT:-3000}/ || exit 1
EXPOSE 3000 3001 3003
ENTRYPOINT ["/bin/bash", "/cryptpad/tester-env-entrypoint.sh"]
CMD ["npm", "start"]
